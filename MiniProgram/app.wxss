/** 全局样式：与 Unity 版「中文拼音助手」配色一致 */
page {
  background: #F3F5FA;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  color: #22304A;
  font-size: 28rpx;
  -webkit-font-smoothing: antialiased;
}

.container {
  display: flex;
  flex-direction: column;
  padding: 0 24rpx;
  box-sizing: border-box;
}

/* 顶部品牌栏 */
.header {
  display: flex;
  align-items: center;
  height: 116rpx;
  background: #3B6EF6;
  border-radius: 20rpx;
  padding: 0 24rpx;
  margin-top: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 110, 246, 0.25);
}

.header-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 14rpx;
  background: #FFFFFF;
  color: #3B6EF6;
  font-size: 34rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.header-title {
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
}

.header-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 20rpx;
  margin-top: 4rpx;
}

/* 卡片 */
.card {
  background: rgba(255, 255, 255, 0.98);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-top: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(20, 30, 60, 0.06);
  border: 1rpx solid #E3E8F2;
}

.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #22304A;
}

.card-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.card-count {
  font-size: 22rpx;
  color: #8A94A6;
}

/* 输入区 */
.input-area {
  width: 100%;
  box-sizing: border-box;
  height: 220rpx;
  background: #F2F4F8;
  border-radius: 14rpx;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
  color: #22304A;
  line-height: 1.5;
}

.option-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
}

.option-label {
  width: 84rpx;
  font-size: 24rpx;
  color: #22304A;
  flex-shrink: 0;
}

.segment {
  display: flex;
  flex: 1;
  background: #F2F4F8;
  border-radius: 12rpx;
  padding: 4rpx;
}

.segment-item {
  flex: 1;
  text-align: center;
  font-size: 22rpx;
  color: #8A94A6;
  padding: 12rpx 0;
  border-radius: 10rpx;
  transition: all 0.15s;
}

.segment-item.active {
  background: #3B6EF6;
  color: #FFFFFF;
  font-weight: 600;
}

.uv-row {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  justify-content: space-between;
}

.uv-label {
  font-size: 24rpx;
  color: #22304A;
}

.btn-row {
  display: flex;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: 12rpx;
  font-size: 26rpx;
  font-weight: 600;
}

.btn-primary {
  background: #3B6EF6;
  color: #FFFFFF;
  margin-right: 16rpx;
}

.btn-ghost {
  background: #F2F4F8;
  color: #8A94A6;
}

.btn-ghost.disabled,
.btn-primary.disabled {
  opacity: 0.5;
}

/* 输出区 */
.output-scroll {
  height: 360rpx;
  background: #FAFBFE;
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  overflow: hidden;
}

/* 逐字标注：汉字行 */
.ann-line {
  margin-bottom: 16rpx;
}

.ann-row {
  display: flex;
  flex-wrap: wrap;
}

.ann-unit {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 8rpx;
}

.ann-pinyin {
  font-size: 20rpx;
  color: #3B6EF6;
  line-height: 1.3;
  white-space: nowrap;
}

.ann-char {
  font-size: 30rpx;
  color: #22304A;
  line-height: 1.4;
}

.ann-plain {
  font-size: 24rpx;
  color: #22304A;
  line-height: 1.6;
  align-self: center;
}

/* 行内对照 / 仅拼音 */
.inline-text {
  font-size: 26rpx;
  color: #22304A;
  line-height: 1.7;
  word-break: break-all;
}

.pinyin-only-text {
  font-size: 26rpx;
  color: #3B6EF6;
  line-height: 1.7;
  word-break: break-all;
}

.empty-tip {
  color: #B9C2D0;
  font-size: 24rpx;
  text-align: center;
  padding-top: 120rpx;
  line-height: 1.8;
}

/* 导出按钮行 */
.export-row {
  display: flex;
  margin-top: 18rpx;
}

.export-btn {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  border-radius: 12rpx;
  font-size: 22rpx;
  font-weight: 600;
  margin-right: 10rpx;
}

.export-btn:last-child {
  margin-right: 0;
}

.export-btn.primary {
  background: #3B6EF6;
  color: #FFFFFF;
}

.export-btn.light {
  background: #E8EEFD;
  color: #3B6EF6;
}

.export-btn.disabled {
  opacity: 0.5;
}

/* 状态栏 */
.status-bar {
  margin-top: 16rpx;
  font-size: 20rpx;
  color: #8A94A6;
  line-height: 1.5;
  min-height: 30rpx;
}

/* 隐私提示条 */
.privacy-tip {
  margin: 20rpx 4rpx 40rpx;
  font-size: 20rpx;
  color: #B9C2D0;
  line-height: 1.6;
  text-align: center;
}
