/* 局部样式补充：设置页特有 */

/* 设置页分段按钮：不换行、舒展 */
.segment-item {
  white-space: nowrap;
  padding: 8rpx 16rpx;
  min-width: 0;
  flex-shrink: 1;
}

/* 导出说明 */
.settings-note-section {
  margin-top: 8rpx;
}
.settings-note-row {
  padding: 16rpx 24rpx;
}
.settings-note {
  font-size: 24rpx;
  color: var(--text-soft);
  line-height: 1.6;
}

/* 关于入口箭头 */
.settings-chevron {
  margin-left: 6rpx;
  color: var(--text-muted);
}

/* 自定义语言选择弹窗 */
.picker-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
}
.picker-modal {
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 24rpx 24rpx calc(24rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -8rpx 32rpx rgba(0, 0, 0, 0.18);
}
.picker-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
  text-align: center;
  margin-bottom: 16rpx;
}
.picker-list {
  max-height: 560rpx;
  margin-bottom: 16rpx;
}
.picker-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  border-radius: 16rpx;
  margin-bottom: 8rpx;
  background: var(--input-bg);
  color: var(--text);
  font-size: 28rpx;
}
.picker-item.active {
  background: var(--primary-soft);
  color: var(--primary);
  font-weight: 600;
}
.picker-item-check {
  font-size: 28rpx;
  color: var(--primary);
}
.picker-actions {
  display: flex;
  gap: 16rpx;
}
.picker-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.picker-btn.cancel {
  background: var(--input-bg);
  color: var(--text-soft);
}
.picker-btn.confirm {
  background: var(--primary);
  color: #FFFFFF;
}
